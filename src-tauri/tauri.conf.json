{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cherry Selection Lite",
  "version": "1.0.4",
  "identifier": "com.cherry.selection.lite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "toolbar",
        "title": "Cherry Toolbar",
        "url": "index.html?window=toolbar",
        "width": 420,
        "height": 52,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "action",
        "title": "Cherry Action",
        "url": "index.html?window=action",
        "width": 520,
        "height": 620,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Cherry Studio 划词助手 - 设置",
        "url": "index.html?window=settings",
        "width": 980,
        "height": 680,
        "decorations": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
